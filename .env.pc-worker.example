# ---- Photo Audit — optional helper-PC worker. Copy to .env.pc-worker and fill in. ----

# The NAS's IP address (find it with:  ping -4 <nas-name>). Use the IP, not the name:
# Docker's Linux VM often can't resolve Windows network names.
NAS_IP=192.168.1.50
# Same as DB_PUBLISH_PORT on the NAS (default 5432)
DB_PORT=5432

# Same value as DB_PASSWORD in the NAS's .env
DB_PASSWORD=change-me-to-a-long-random-string

# SMB paths as seen from the network: //NAS_IP/<this>.
#   SMB_LIBRARY_SHARE: the share that LIBRARY_PATH points to on the NAS (QNAP: Multimedia, Synology: photo)
#   SMB_THUMBS_PATH:   the share + folder that THUMBS_PATH points to
SMB_LIBRARY_SHARE=Multimedia
SMB_THUMBS_PATH=Container/photo-audit/thumbs

# A NAS account with read access to the library share and read/write to the thumbs folder.
# Avoid commas and quotes in this password (it's passed as an SMB mount option).
SMB_USER=photoaudit
SMB_PASSWORD=change-me
# Lower to 2.1 for older NAS firmware if mounting fails
SMB_VERSION=3.0

# Name shown in Settings. Give each helper PC its own (e.g. pc-office) if more than one runs at the same time.
PC_WORKER_NAME=pc

# Must match the NAS setting if you changed it
QUARANTINE_DIRNAME=.quarantine

# Worker processes: logical CPU cores minus 1 (Task Manager -> Performance -> CPU -> Logical processors),
# but no more than (RAM in GB) / 1.5, because each process loads the face models (~0.7 GB).
PC_WORKER_CONCURRENCY=7
# Threads per process for face recognition (leave at 1; processes already use every core)
PC_FACE_THREADS=1
