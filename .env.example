# ---- Photo Audit — NAS/server configuration. Copy to .env and fill in. ----
# Full reference: README.md -> "Configuration".

# --- Required -------------------------------------------------------------------------
# Long random strings. Generate e.g. with:  openssl rand -hex 24
DB_PASSWORD=change-me-to-a-long-random-string
SECRET_KEY=change-me-to-another-long-random-string

# Paths ON THE HOST running Docker.
#   LIBRARY_PATH: the media share; each user's photos live in a top-level folder inside it.
#   THUMBS_PATH:  a folder for thumbnails/previews (must also be reachable over SMB if you use the PC worker).
# QNAP example:     /share/Multimedia            and /share/Container/photo-audit/thumbs
# Synology example: /volume1/photo               and /volume1/docker/photo-audit/thumbs
LIBRARY_PATH=/share/Multimedia
THUMBS_PATH=/share/Container/photo-audit/thumbs

# --- Accounts --------------------------------------------------------------------------
# Admin created on first start (admins create and manage everyone else's accounts).
# Leave ADMIN_PASSWORD empty to have a random one printed in `docker compose logs api`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Optional --------------------------------------------------------------------------
# Name shown in the browser tab, sidebar and sign-in page.
APP_NAME=Photo Audit
# Web port -> http://<nas-name-or-ip>:8090
# (not 8080: QNAP's own admin page QTS uses 8080 by default)
APP_PORT=8090
# Background processing threads on the NAS (keep low so the NAS stays responsive).
NAS_WORKER_CONCURRENCY=2
# Folder inside LIBRARY_PATH that approved deletions are moved to (must start with "." or "@").
QUARANTINE_DIRNAME=.quarantine
# Map tiles: default is OpenStreetMap (needs internet). Use your own tile server URL for offline use,
# or MAP_TILE_URL=off to hide the Map page.
MAP_TILE_URL=
MAP_ATTRIBUTION=
# Another NAS volume to show (free space only, mounted read-only) in Settings -> NAS resources,
# e.g. EXTRA_VOLUME_PATH=/share/CACHEDEV2_DATA. Leave empty to show only the library/app-data volume.
EXTRA_VOLUME_PATH=
EXTRA_VOLUME_LABEL=
# --- Public share links (optional) -------------------------------------------------------
# COMPOSE_PROFILES=public starts the share-only container (album links only, nothing else).
# Combine profiles with commas, e.g. COMPOSE_PROFILES=remote,public
# PUBLIC_SHARE_URL is the address people outside will use, e.g. https://photo-share.<tailnet>.ts.net
PUBLIC_SHARE_URL=
SHARE_PUBLISH=127.0.0.1:8091
# Public internet access for share links via Tailscale Funnel (add 'public' to COMPOSE_PROFILES).
# A second auth key, used once for the public machine's first start.
TS_SHARE_AUTHKEY=
TS_SHARE_HOSTNAME=photo-share

# --- Remote access for app users (optional, Tailscale) ---------------------------------
# Set COMPOSE_PROFILES=remote and paste an auth key from https://login.tailscale.com/admin/settings/keys
# The app is then at https://<TS_HOSTNAME>.<your-tailnet>.ts.net for devices signed in to your tailnet.
# The auth key is only needed for the first start; you can delete it from .env afterwards.
COMPOSE_PROFILES=
TS_AUTHKEY=
TS_HOSTNAME=photo-audit
# Face recognition: CPU threads per worker process (turn the feature on in the app: People page)
FACE_THREADS=2
# File-creation mask for thumbnails/uploads (octal). 000 lets a helper-PC worker (other NAS account) write too.
UMASK=000
# Timezone for logs/schedules, e.g. America/Chicago
TZ=UTC
# Database port published on the LAN (only needed by the helper-PC worker).
DB_PUBLISH_PORT=5432
# Resource tuning
DB_SHARED_BUFFERS=512MB
DB_MEM_LIMIT=1g
API_MEM_LIMIT=1g
WORKER_MEM_LIMIT=2g
